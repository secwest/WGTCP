# SSH keys must never be committed.
*_id_ed25519
*_id_ed25519.pub

# Per-cell raw output and logs (large, transient).
results/*/cells/
results/*/raw/
*.log

# Local backups.
harness-hub-bak/

# Python validation artifacts.
__pycache__/
*.pyc

# Meltdown campaigns keep raw cells local; compact summaries are committed.
meltdown/results/*/cells/
meltdown/results/*/campaign.log
