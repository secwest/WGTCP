+        self.assertIn("} else if (unlikely(rt->dst.dev == skb->dev)) {", send4)
+        self.assertIn("ip_rt_put(rt);\n\t\t\tret = -ELOOP;", send4)
+        self.assertIn("} else if (unlikely(dst->dev == skb->dev)) {", send6)
