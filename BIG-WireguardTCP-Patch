+        }
+        $failure = @(
+            Get-Content -LiteralPath $stdoutPath, $stderrPath -ErrorAction SilentlyContinue
+        ) -join [Environment]::NewLine
+        return [ordered]@{ Success = $false; Failure = "exit $($process.ExitCode): $failure" }
+    } finally {
+        $process.Dispose()
+    }
