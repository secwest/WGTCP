+void wg_allowedips_init(struct allowedips *table)
+{
+	wg_dbg("Entering wg_allowedips_init(table=%px)\n", table);
+	table->root4 = table->root6 = NULL;
+	table->seq = 1;
+	wg_dbg("Exiting wg_allowedips_init\n");
+}
