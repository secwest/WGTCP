-static ssize_t mnl_socket_recvfrom(const struct mnl_socket *nl, void *buf,
-				   size_t bufsiz)
-{
-	ssize_t ret;
-	struct sockaddr_nl addr;
-	struct iovec iov = {
-		.iov_base	= buf,
-		.iov_len	= bufsiz,
-	};
-	struct msghdr msg = {
-		.msg_name	= &addr,
-		.msg_namelen	= sizeof(struct sockaddr_nl),
-		.msg_iov	= &iov,
-		.msg_iovlen	= 1,
-		.msg_control	= NULL,
-		.msg_controllen	= 0,
-		.msg_flags	= 0,
-	};
-	ret = recvmsg(nl->fd, &msg, 0);
-	if (ret == -1)
-		return ret;
-
-	if (msg.msg_flags & MSG_TRUNC) {
-		errno = ENOSPC;
-		return -1;
-	}
-	if (msg.msg_namelen != sizeof(struct sockaddr_nl)) {
-		errno = EINVAL;
-		return -1;
-	}
-	return ret;
-}
