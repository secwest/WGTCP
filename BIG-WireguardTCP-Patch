+out:
+	up_write(&handshake->lock);
+	up_read(&handshake->static_identity->lock);
+	memzero_explicit(key, NOISE_SYMMETRIC_KEY_LEN);
+
+	wg_dbg("Exiting wg_noise_handshake_create_initiation with dst: %p, handshake: %p, result: %d\n",
