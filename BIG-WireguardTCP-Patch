+		{ true, VALID_MAC_BUT_NO_COOKIE, WG_COOKIE_CHALLENGE },
+		{ true, VALID_MAC_WITH_COOKIE_BUT_RATELIMITED, WG_COOKIE_DROP },
+		{ true, VALID_MAC_WITH_COOKIE, WG_COOKIE_ACCEPT }
+	};
+	size_t i;
