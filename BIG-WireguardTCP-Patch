+    )
+    $stdoutPath = Join-Path $ResultsDirectory ("exec-probe-{0}.stdout.log" -f $Name)
+    $stderrPath = Join-Path $ResultsDirectory ("exec-probe-{0}.stderr.log" -f $Name)
