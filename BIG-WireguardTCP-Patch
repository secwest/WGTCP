-	values="${OFFSETS[$key]}"
-	values=( ${values//,/ } )
-	for i in {0..3}; do
-		value="$ARGUMENT_REGISTER"
-		for indirection in "${values[@]:1}"; do
-			value="+$indirection($value)"
-		done
-		value="+$((i * 8 + values[0]))($value)"
