+// Print the netlink message using libmnl format
+static void wg_print_netlink_message_libmnl(const struct nlmsghdr *nlh)
+{
+    wg_print_netlink_header_libmnl(nlh);
+    wg_print_netlink_payload_libmnl(nlh, 0);
+}
