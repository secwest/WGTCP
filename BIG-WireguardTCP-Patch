+	ret = 0;
+
+	cleanup:
+	free_wgdevice(device);
+	if (ret != 0)
+		show_usage(argv[0]);
+	DEBUG_PRINT("Exiting set_main with ret=%d\n", ret);
+	return ret;
+}
